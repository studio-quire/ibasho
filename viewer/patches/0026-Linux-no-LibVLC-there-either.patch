From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Claude Opus 5.5" <noreply@anthropic.com>
Date: Mon, 2 Nov 2026 11:30:09 +0000
Subject: [PATCH 26/35] Linux: no LibVLC there either

The Linux build listed media_plugin_libvlc among the targets its package
copies, and its manifest shipped the plugin, after patch "No LibVLC"
dropped the plugin's directory from the build. Linux plays media through
GStreamer and CEF; the example plugin isn't shipped either.
---
 doc/IBASHO-CHANGES.txt           | 10 +++++-----
 indra/newview/CMakeLists.txt     |  7 +++----
 indra/newview/viewer_manifest.py | 13 ++++---------
 3 files changed, 12 insertions(+), 18 deletions(-)

diff --git a/doc/IBASHO-CHANGES.txt b/doc/IBASHO-CHANGES.txt
index 731f2fa..014e168 100644
--- a/doc/IBASHO-CHANGES.txt
+++ b/doc/IBASHO-CHANGES.txt
@@ -26,8 +26,8 @@ indra/media_plugins/CMakeLists.txt
     Modified for Ibasho (2026-10-23): no LibVLC media plugin (VLC is GPL; the CEF plugin plays
     media).
 indra/newview/CMakeLists.txt
-    Modified for Ibasho (2026-10-10, 2026-10-22, 2026-10-23): builds the Ibasho LEAP API files;
-    the Windows viewer doesn't depend on the LibVLC or example media plugins.
+    Modified for Ibasho (2026-10-10, 2026-10-22, 2026-10-23, 2026-11-02): builds the Ibasho LEAP
+    API files; the viewer doesn't depend on the LibVLC or example media plugins.
 indra/newview/VIEWER_VERSION.txt
     Modified for Ibasho (2026-10-22): Ibasho's own version number (a data file read by CMake).
 indra/newview/app_settings/settings.xml
@@ -298,9 +298,9 @@ indra/newview/skins/default/xui/zh/strings.xml
     AboutHeader overrides removed, so the English (Ibasho) ones apply; the LibVLC line removed
     from AboutLibs (no LibVLC in Ibasho).
 indra/newview/viewer_manifest.py
-    Modified for Ibasho (2026-10-22, 2026-10-23): app, executable and installer names (Ibasho,
-    IbashoViewer.exe); build_data.json names Ibasho as the channel base and no update service; the
-    Windows package has no LibVLC (GPL) or example media plugin.
+    Modified for Ibasho (2026-10-22, 2026-10-23, 2026-11-02): app, executable and installer names
+    (Ibasho, IbashoViewer.exe); build_data.json names Ibasho as the channel base and no update
+    service; the Windows and Linux packages have no LibVLC (GPL) or example media plugin.
 scripts/packages-formatter.py
     Modified for Ibasho (2026-10-23): the About box's Licenses tab says Linden Lab's copyright is
     for the viewer Ibasho is built on, not for Ibasho.
diff --git a/indra/newview/CMakeLists.txt b/indra/newview/CMakeLists.txt
index b033f32..b602149 100644
--- a/indra/newview/CMakeLists.txt
+++ b/indra/newview/CMakeLists.txt
@@ -1,6 +1,6 @@
 # -*- cmake -*-
-# Modified for Ibasho (2026-10-10, 2026-10-22, 2026-10-23): builds the Ibasho LEAP API files; the
-# Windows viewer doesn't depend on the LibVLC or example media plugins. Changes are marked "Ibasho".
+# Modified for Ibasho (2026-10-10, 2026-10-22, 2026-10-23, 2026-11-02): builds the Ibasho LEAP API files;
+# the viewer doesn't depend on the LibVLC or example media plugins. Changes are marked "Ibasho".
 
 project(viewer)
 
@@ -2188,8 +2188,7 @@ if (LINUX)
     SLPlugin
     media_plugin_cef
     media_plugin_gstreamer10
-    media_plugin_libvlc
-    media_plugin_example
+    # Ibasho: no media_plugin_libvlc (GPL; GStreamer and CEF play media) or media_plugin_example
     llwebrtc
     )
 
diff --git a/indra/newview/viewer_manifest.py b/indra/newview/viewer_manifest.py
index f8d4cbb..a469ca2 100755
--- a/indra/newview/viewer_manifest.py
+++ b/indra/newview/viewer_manifest.py
@@ -26,9 +26,9 @@ Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301  USA
 Linden Research, Inc., 945 Battery Street, San Francisco, CA  94111  USA
 $/LicenseInfo$
 """
-# Modified for Ibasho (2026-10-22, 2026-10-23): app, executable and installer names (Ibasho,
+# Modified for Ibasho (2026-10-22, 2026-10-23, 2026-11-02): app, executable and installer names (Ibasho,
 # IbashoViewer.exe); build_data.json names Ibasho as the channel base and no update service; the
-# Windows package has no LibVLC (GPL) or example media plugin. Changes are marked "Ibasho".
+# Windows and Linux packages have no LibVLC (GPL) or example media plugin. Changes are marked "Ibasho".
 import errno
 import glob
 import itertools
@@ -1369,18 +1369,13 @@ class LinuxManifest(ViewerManifest):
                 with self.prefix(src='cef'):
                     self.path("libmedia_plugin_cef.so")
 
-                # Media plugins - LibVLC
-                with self.prefix(src='libvlc'):
-                    self.path("libmedia_plugin_libvlc.so")
+                # Ibasho: no LibVLC media plugin (GPL; GStreamer and CEF play media)
 
                 # GStreamer 1.0 Media Plugin
                 with self.prefix(src='gstreamer10'):
                     self.path("libmedia_plugin_gstreamer10.so")
 
-                # Media plugins - Example (useful for debugging - not shipped with release viewer)
-                if self.channel_type() != 'release':
-                    with self.prefix(src='example'):
-                        self.path("libmedia_plugin_example.so")
+                # Ibasho: no example media plugin
 
 
         with self.prefix(src=os.path.join(pkgdir, 'lib', 'release'), dst="lib"):
